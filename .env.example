# Azure OpenAI: the LLM behind onboarding (rule translation) and tool classification
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: force the provider, azure or anthropic. Default: azure.
# AGENTGUARD_PROVIDER=azure

# Anthropic: the demo agent (Claude Agent SDK). Also usable for onboarding with AGENTGUARD_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Stripe - test-mode restricted key only (prefix rk_test_)
STRIPE_API_KEY=rk_test_

# Email - Resend
RESEND_API_KEY=

# Email - SMTP (alternative to Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Slack - Socket Mode app token (xapp-) and bot token (xoxb-)
SLACK_APP_TOKEN=xapp-
SLACK_BOT_TOKEN=xoxb-
# Channel ID of #agent-approvals (starts with C)
SLACK_APPROVAL_CHANNEL=
